<view class="page">
  <view class="glass hero"><text class="eyebrow">TEXT TOOLS</text><view class="title">文本工具箱</view><view class="muted">润色、翻译、校对与结构整理都由 DeepSeek 完成。</view></view>
  <view class="glass form">
    <view class="field"><text>选择工具</text><picker range="{{tools}}" value="{{toolIndex}}" bindchange="choose"><view class="picker">{{tools[toolIndex]}} 〉</view></picker></view>
    <view class="field"><text>原文</text><textarea class="textarea" maxlength="4000" value="{{text}}" bindinput="input" placeholder="粘贴需要处理的完整文字"/></view>
    <button class="primary" loading="{{loading}}" bindtap="run">{{loading ? "正在处理…" : "开始处理"}}</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view wx:if="{{result}}" class="glass result"><view class="result-title row between"><text>处理结果</text><text class="pill" bindtap="copy">复制</text></view><view class="result-content">{{result}}</view></view>
</view>
