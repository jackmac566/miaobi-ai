page{background:#fffaf6;color:#372f2b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:28rpx 28rpx 80rpx}.glass{background:rgba(255,255,255,.84);border:1rpx solid rgba(255,255,255,.95);border-radius:32rpx;box-shadow:0 20rpx 55rpx rgba(78,42,27,.08)}.hero{padding:32rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#e86552}.title{font-size:48rpx;font-weight:800;line-height:1.25;margin:12rpx 0}.muted{color:#8e7e77;font-size:26rpx;line-height:1.65}.row{display:flex;align-items:center}.between{justify-content:space-between}.primary{border:0!important;border-radius:26rpx!important;background:linear-gradient(120deg,#ff6257,#ff965e)!important;color:#fff!important;font-weight:700!important}.secondary{border:1rpx solid #edd9cf!important;border-radius:22rpx!important;background:#fff!important;color:#6d5e57!important}.field{margin-top:24rpx}.field text{display:block;font-size:25rpx;font-weight:700;margin-bottom:12rpx}.input,.textarea,.picker{width:100%;box-sizing:border-box;border:1rpx solid #ead9d0;border-radius:24rpx;background:#fffdfa;padding:22rpx;font-size:28rpx}.textarea{min-height:220rpx}.section-title{font-size:34rpx;font-weight:800;margin:34rpx 4rpx 18rpx}.pill{display:inline-block;padding:10rpx 18rpx;border-radius:999rpx;background:#fff0e8;color:#df5b49;font-size:22rpx}.result{padding:28rpx;margin-top:20rpx}.result-title{font-weight:800;margin-bottom:15rpx}.result-content{white-space:pre-wrap;line-height:1.8;font-size:28rpx}.empty{text-align:center;color:#9e8f88;padding:90rpx 20rpx}.error{margin-top:20rpx;padding:20rpx;border-radius:20rpx;background:#fff0ed;color:#ad372f}.success{margin-top:20rpx;padding:20rpx;border-radius:20rpx;background:#eaf9f3;color:#177b5e}.count{font-size:24rpx;color:#786a64}.count b{font-size:34rpx;color:#ed604d}.card-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.scene-card{padding:24rpx}.scene-card .icon{display:grid;place-items:center;width:78rpx;height:78rpx;border-radius:24rpx;background:linear-gradient(140deg,#ff8d79,#ff6257);color:#fff;font-weight:800}.scene-card .name{font-weight:800;margin:18rpx 0 8rpx}.scene-card .desc{font-size:23rpx;color:#8c7d76;line-height:1.5}.account-button{padding:13rpx 20rpx;border-radius:999rpx;background:rgba(255,255,255,.8);font-size:23rpx;color:#db5d4b}.notice{margin-top:22rpx;padding:20rpx 22rpx;border-radius:22rpx;background:#fff2e9;color:#886c60;font-size:23rpx;line-height:1.6}.toolbar{display:flex;gap:14rpx;margin-top:20rpx}.toolbar button{flex:1;font-size:24rpx}.search{height:80rpx;border:1rpx solid #ead9d0;border-radius:24rpx;background:#fff;padding:0 24rpx}.history-item{padding:24rpx;margin-bottom:18rpx}.history-item .meta{font-size:22rpx;color:#df624f}.history-item .name{font-size:29rpx;font-weight:800;margin:8rpx 0}.history-item .preview{font-size:24rpx;color:#82746d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8rpx;background:#f4eae4;padding:8rpx;border-radius:24rpx}.auth-tabs button{border:0;background:transparent}.auth-tabs button.active{background:#fff;color:#e45b49;border-radius:18rpx}.safe-bottom{height:40rpx}
